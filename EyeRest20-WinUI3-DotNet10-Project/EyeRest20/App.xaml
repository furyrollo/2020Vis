<Application
    x:Class="EyeRest20.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Fluent Theme Accent Colors for EyeRest -->
            <SolidColorBrush x:Key="EyeRestAccentBrush" Color="#0EA5E9" />
            <SolidColorBrush x:Key="EyeRestRestBrush" Color="#10B981" />
            <SolidColorBrush x:Key="EyeRestMutedBrush" Color="#64748B" />
        </ResourceDictionary>
    </Application.Resources>
</Application>